# Keep the distributed package to what a consumer actually runs: the test
# suite, the Testbench workbench (which holds the maintainer-only release
# check) and the tooling around them stay out of the archive Composer downloads.
/.github               export-ignore
/tests                 export-ignore
/workbench             export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
/artisan               export-ignore
/testbench.yaml        export-ignore
/phpstan.neon          export-ignore
/phpstan-baseline.neon export-ignore
/phpunit.xml           export-ignore
/pint.json             export-ignore

# The JavaScript toolchain is maintainer-only: it drives the browser tests.
/package.json          export-ignore
/package-lock.json     export-ignore

# Auto detect text files and perform LF normalization
* text=auto
